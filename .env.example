# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.
#
# For local development, the defaults below point at a MySQL running on localhost.
# For production (server), override DB_URL/FILE_PUBLIC_URL/ORIGIN_URL etc. per environment.

# ===== Database =====
# Local dev: jdbc:mysql://localhost:3306/hipro_school_db
# Prod:      jdbc:mysql://<db-host>:3306/hipro_school_db
DB_URL=jdbc:mysql://localhost:3306/hipro_school_db
DB_USERNAME=hipro_user
DB_PASSWORD=change-me

# ===== Mail (SMTP) =====
# Gmail (port 587, STARTTLS) — recommended for dev
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
# Hostinger (port 465, SSL) — alternative
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_USERNAME=info@example.com
# MAIL_PASSWORD=change-me

# ===== Security =====
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== File uploads =====
# Files are served by Spring at /api/uploads/** (no nginx needed)
FILE_UPLOAD_DIR=/opt/upload-files/
FILE_PUBLIC_URL=http://localhost:7979/api/uploads/
ORIGIN_URL=http://localhost:3000/

# ===== Server =====
SERVER_PORT=7979
SPRING_PROFILES_ACTIVE=dev
API_DOCS_URL=http://localhost:7979/api/v3/api-docs

# ===== AI providers (optional) =====
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XKIRO_API_KEY=
