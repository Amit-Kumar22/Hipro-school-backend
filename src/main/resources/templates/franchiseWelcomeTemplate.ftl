<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Welcome to Khana Mart Franchise</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f9f4; font-family:'Segoe UI', Arial, sans-serif;">

<table align="center" width="100%" cellpadding="0" cellspacing="0"
       style="max-width:650px; margin:30px auto; background:#ffffff;
       border-radius:10px; box-shadow:0 5px 15px rgba(0,0,0,0.08); overflow:hidden;">

    <!-- Header -->
    <tr>
        <td style="background:linear-gradient(135deg,#28a745,#218838);
                   padding:25px; text-align:center; color:#ffffff;">
            <h2 style="margin:0;">🎉 Welcome to Khana Mart Franchise</h2>
        </td>
    </tr>

    <!-- Content -->
    <tr>
        <td style="padding:30px; color:#333; font-size:15px; line-height:1.6;">

            <p>Dear <strong>${ownerName}</strong>,</p>

            <p>
                Congratulations! Your franchise <strong>${franchiseName}</strong>
                has been successfully registered with Khana Mart.
            </p>

            <p>
                You can now access your franchise dashboard using the link below:
            </p>

            <p style="text-align:center; margin:25px 0;">
                <a href="${loginUrl}"
                   style="background-color:#28a745; color:#ffffff;
                          padding:12px 25px; text-decoration:none;
                          border-radius:6px; font-weight:bold;">
                    Login to Dashboard
                </a>
            </p>

            <p>
                For security reasons, please use the
                <strong>Forgot Password</strong> option to set your password
                before your first login.
            </p>

            <p>
                If you need any assistance, feel free to contact our support team.
            </p>

            <br>
            <p>Warm Regards,</p>
            <p><strong>Khana Mart Team</strong></p>

        </td>
    </tr>

    <!-- Footer -->
    <tr>
        <td style="background:#f1fdf5; text-align:center;
                   padding:15px; font-size:12px; color:#777;">
            © 2026 Khana Mart. All rights reserved.
        </td>
    </tr>

</table>

</body>
</html>
